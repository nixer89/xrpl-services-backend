{
  "name": "xrpl-services-backend",
  "version": "6.0.0",
  "description": "provides a generic backend, connected to xumm. Easy access of user tokens for push",
  "main": "src/server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "develop": "tsc && concurrently \"tsc -w\" \"nodemon dist/server.js\"",
    "build": "tsc",
    "reprocess:escrows": "tsc && node dist/scripts/reprocessEscrowsFromLogs.js",
    "scan:autorelease-payments": "tsc && node dist/scripts/scanAutoReleasePayments.js",
    "postinstall": "sh ./src/doc/updateSwaggerVersion.sh",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nixer89/xrpl-services-backend.git"
  },
  "keywords": [
    "xumm",
    "xrp",
    "xrpl"
  ],
  "author": "nixer89",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/nixer89/xrpl-services-backend/issues"
  },
  "homepage": "https://github.com/nixer89/xrpl-services-backend#readme",
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "device-detector-js": "^3.0.3",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "log-timestamp": "^0.3.0",
    "mongodb": "^7.9.1",
    "node-fetch": "^2.7.0",
    "node-schedule": "^2.1.2",
    "pino": "^10.4.0",
    "verify-xrpl-signature": "^9.2.0",
    "xrpl": "^5.3.0",
    "xumm-sdk": "^1.11.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "@types/node-fetch": "^2.6.13",
    "@types/node-schedule": "^2.1.8",
    "concurrently": "^10.0.7",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "bufferutil": false,
    "es5-ext": false,
    "utf-8-validate": false
  }
}
